{
  "name": "aggrega",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.10.4",
  "publisher": "aggrega-ai",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/aggrega-ai/aggrega-vscode-extension"
  },
  "icon": "media/listing-icon.png",
  "aggregaCompatibility": ">=0.9.0 <0.11.0",
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml",
    "workspaceContains:**/.aggrega-config.yaml"
  ],
  "main": "./out/src/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aggrega",
          "title": "%viewsContainers.activitybar.aggrega.title%",
          "icon": "media/aggrega.svg"
        }
      ]
    },
    "views": {
      "aggrega": [
        {
          "id": "aggrega.operations",
          "name": "%views.aggrega.operations.name%",
          "type": "webview",
          "initialSize": 50
        },
        {
          "id": "aggrega.registries",
          "name": "%views.aggrega.registries.name%"
        },
        {
          "id": "aggrega.workspaceCatalog",
          "name": "%views.aggrega.workspaceCatalog.name%"
        },
        {
          "id": "aggrega.plugins",
          "name": "%views.aggrega.plugins.name%"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aggrega.getStarted.open",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.openOnStartup",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.createWorkspace",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.chooseWorkspace",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.useCompilerOnPath",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.locateCompiler",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.downloadCompiler",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.draftRelease",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.seedRegistry",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.seedNamedRegistry",
          "when": "false"
        },
        {
          "command": "aggrega.server.lifecycleActions",
          "when": "false"
        },
        {
          "command": "aggrega.registries.updateOne",
          "when": "false"
        },
        {
          "command": "aggrega.registries.remove",
          "when": "false"
        },
        {
          "command": "aggrega.registries.logout",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.inspect",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.validate",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.lint",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.push",
          "when": "false"
        },
        {
          "command": "aggrega.plugins.remove",
          "when": "false"
        },
        {
          "command": "aggrega.workspace.openRootFolder",
          "when": "false"
        },
        {
          "command": "aggrega.graph.attachToConnectionAtCursor",
          "when": "resourcePath in aggrega.connectionDocuments"
        }
      ],
      "view/title": [
        {
          "command": "aggrega.op.draft",
          "when": "view == aggrega.operations",
          "group": "navigation"
        },
        {
          "command": "aggrega.op.draft",
          "when": "view == aggrega.registries",
          "group": "navigation"
        },
        {
          "command": "aggrega.op.draft",
          "when": "view == aggrega.workspaceCatalog",
          "group": "navigation"
        },
        {
          "command": "aggrega.op.draft",
          "when": "view == aggrega.plugins",
          "group": "navigation"
        },
        {
          "command": "aggrega.op.draft",
          "when": "view == workbench.explorer.fileView",
          "group": "navigation"
        },
        {
          "command": "aggrega.op.draft",
          "when": "view == workbench.explorer.emptyView",
          "group": "navigation"
        },
        {
          "command": "aggrega.getStarted.open",
          "when": "view == aggrega.operations",
          "group": "navigation"
        },
        {
          "command": "aggrega.settings.open",
          "when": "view == aggrega.operations",
          "group": "navigation"
        },
        {
          "command": "aggrega.plugins.refresh",
          "when": "view == aggrega.plugins",
          "group": "navigation"
        },
        {
          "command": "aggrega.registries.refresh",
          "when": "view == aggrega.registries",
          "group": "navigation"
        },
        {
          "command": "aggrega.workspaceCatalog.refresh",
          "when": "view == aggrega.workspaceCatalog",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aggrega.registries.updateOne",
          "when": "viewItem == aggrega.registry",
          "group": "inline"
        },
        {
          "command": "aggrega.registries.updateOne",
          "when": "viewItem == aggrega.registry",
          "group": "registry@1"
        },
        {
          "command": "aggrega.registries.logout",
          "when": "viewItem == aggrega.registry",
          "group": "registry@2"
        },
        {
          "command": "aggrega.registries.remove",
          "when": "viewItem == aggrega.registry",
          "group": "registry@3"
        },
        {
          "command": "aggrega.workspaceCatalog.inspect",
          "when": "viewItem =~ /^aggrega\\.catalogEntity(:[a-z]+)*:inspect(:[a-z]+)*$/",
          "group": "inline"
        },
        {
          "command": "aggrega.workspaceCatalog.inspect",
          "when": "viewItem =~ /^aggrega\\.catalogEntity(:[a-z]+)*:inspect(:[a-z]+)*$/",
          "group": "catalogEntity@1"
        },
        {
          "command": "aggrega.workspaceCatalog.validate",
          "when": "viewItem =~ /^aggrega\\.catalogEntity(:[a-z]+)*:validate(:[a-z]+)*$/",
          "group": "catalogEntity@2"
        },
        {
          "command": "aggrega.workspaceCatalog.lint",
          "when": "viewItem =~ /^aggrega\\.catalogEntity(:[a-z]+)*:lint(:[a-z]+)*$/",
          "group": "catalogEntity@3"
        },
        {
          "command": "aggrega.workspaceCatalog.push",
          "when": "viewItem =~ /^aggrega\\.catalogEntity(:[a-z]+)*:push(:[a-z]+)*$/",
          "group": "catalogEntityPublish@1"
        },
        {
          "command": "aggrega.plugins.remove",
          "when": "viewItem == aggrega.plugin.configEntry",
          "group": "plugin@1"
        }
      ],
      "editor/context": [
        {
          "command": "aggrega.graph.attachToConnectionAtCursor",
          "when": "resourcePath in aggrega.connectionDocuments",
          "group": "aggrega@1"
        }
      ],
      "explorer/context": [
        {
          "command": "aggrega.op.import",
          "when": "resourceScheme == file || resourceScheme == vscode-remote",
          "group": "aggrega@1"
        }
      ]
    },
    "commands": [
      {
        "command": "aggrega.getStarted.show",
        "title": "%command.aggrega.getStarted.show.title%"
      },
      {
        "command": "aggrega.getStarted.open",
        "title": "%command.aggrega.getStarted.open.title%",
        "category": "%command.category%",
        "icon": "$(home)"
      },
      {
        "command": "aggrega.getStarted.dismiss",
        "title": "%command.aggrega.getStarted.dismiss.title%"
      },
      {
        "command": "aggrega.getStarted.openOnStartup",
        "title": "%command.aggrega.getStarted.openOnStartup.title%"
      },
      {
        "command": "aggrega.getStarted.createWorkspace",
        "title": "%command.aggrega.getStarted.createWorkspace.title%"
      },
      {
        "command": "aggrega.getStarted.chooseWorkspace",
        "title": "%command.aggrega.getStarted.chooseWorkspace.title%"
      },
      {
        "command": "aggrega.getStarted.useCompilerOnPath",
        "title": "%command.aggrega.getStarted.useCompilerOnPath.title%"
      },
      {
        "command": "aggrega.getStarted.locateCompiler",
        "title": "%command.aggrega.getStarted.locateCompiler.title%"
      },
      {
        "command": "aggrega.getStarted.downloadCompiler",
        "title": "%command.aggrega.getStarted.downloadCompiler.title%"
      },
      {
        "command": "aggrega.compiler.selectVersion",
        "title": "%command.aggrega.compiler.selectVersion.title%"
      },
      {
        "command": "aggrega.compiler.showLicenses",
        "title": "%command.aggrega.compiler.showLicenses.title%"
      },
      {
        "command": "aggrega.getStarted.draftRelease",
        "title": "%command.aggrega.getStarted.draftRelease.title%"
      },
      {
        "command": "aggrega.getStarted.seedRegistry",
        "title": "%command.aggrega.getStarted.seedRegistry.title%"
      },
      {
        "command": "aggrega.getStarted.seedNamedRegistry",
        "title": "%command.aggrega.getStarted.seedNamedRegistry.title%"
      },
      {
        "command": "aggrega.settings.open",
        "title": "%command.aggrega.settings.open.title%",
        "category": "%command.category%",
        "icon": "$(gear)"
      },
      {
        "command": "aggrega.graph.show",
        "title": "%command.aggrega.graph.show.title%",
        "category": "%command.category%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "aggrega.graph.attachToConnectionAtCursor",
        "title": "%command.aggrega.graph.attachToConnectionAtCursor.title%",
        "category": "%command.category%"
      },
      {
        "command": "aggrega.catalog.searchPublished",
        "title": "%command.aggrega.catalog.searchPublished.title%",
        "category": "%command.category%",
        "icon": "$(cloud)"
      },
      {
        "command": "aggrega.plugins.refresh",
        "title": "%command.aggrega.plugins.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "aggrega.plugins.add",
        "title": "%command.aggrega.plugins.add.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "aggrega.plugins.genCatalog",
        "title": "%command.aggrega.plugins.genCatalog.title%",
        "category": "%command.category%",
        "icon": "$(export)"
      },
      {
        "command": "aggrega.plugins.remove",
        "title": "%command.aggrega.plugins.remove.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "aggrega.registries.refresh",
        "title": "%command.aggrega.registries.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "aggrega.registries.add",
        "title": "%command.aggrega.registries.add.title%",
        "category": "%command.category%",
        "icon": "$(add)"
      },
      {
        "command": "aggrega.registries.update",
        "title": "%command.aggrega.registries.update.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aggrega.registries.updateOne",
        "title": "%command.aggrega.registries.updateOne.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aggrega.registries.remove",
        "title": "%command.aggrega.registries.remove.title%",
        "category": "%command.category%",
        "icon": "$(trash)"
      },
      {
        "command": "aggrega.registries.logout",
        "title": "%command.aggrega.registries.logout.title%",
        "category": "%command.category%",
        "icon": "$(sign-out)"
      },
      {
        "command": "aggrega.workspaceCatalog.refresh",
        "title": "%command.aggrega.workspaceCatalog.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "aggrega.workspaceCatalog.inspect",
        "title": "%command.aggrega.workspaceCatalog.inspect.title%",
        "category": "%command.category%",
        "icon": "$(list-tree)"
      },
      {
        "command": "aggrega.workspaceCatalog.validate",
        "title": "%command.aggrega.workspaceCatalog.validate.title%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "aggrega.workspaceCatalog.lint",
        "title": "%command.aggrega.workspaceCatalog.lint.title%",
        "category": "%command.category%",
        "icon": "$(search)"
      },
      {
        "command": "aggrega.workspaceCatalog.push",
        "title": "%command.aggrega.workspaceCatalog.push.title%",
        "category": "%command.category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aggrega.op.validate",
        "title": "%command.aggrega.op.validate.title%",
        "category": "%command.category%",
        "icon": "$(check)"
      },
      {
        "command": "aggrega.op.build",
        "title": "%command.aggrega.op.build.title%",
        "category": "%command.category%",
        "icon": "$(package)"
      },
      {
        "command": "aggrega.op.preview",
        "title": "%command.aggrega.op.preview.title%",
        "category": "%command.category%",
        "icon": "$(eye)"
      },
      {
        "command": "aggrega.op.lint",
        "title": "%command.aggrega.op.lint.title%",
        "category": "%command.category%",
        "icon": "$(search)"
      },
      {
        "command": "aggrega.op.pull",
        "title": "%command.aggrega.op.pull.title%",
        "category": "%command.category%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aggrega.op.scaffold",
        "title": "%command.aggrega.op.scaffold.title%",
        "category": "%command.category%",
        "icon": "$(new-file)"
      },
      {
        "command": "aggrega.op.draft",
        "title": "%command.aggrega.op.draft.title%",
        "category": "%command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "aggrega.op.import",
        "title": "%command.aggrega.op.import.title%",
        "category": "%command.category%",
        "icon": "$(arrow-into)"
      },
      {
        "command": "aggrega.op.inspect",
        "title": "%command.aggrega.op.inspect.title%",
        "category": "%command.category%",
        "icon": "$(list-tree)"
      },
      {
        "command": "aggrega.op.push",
        "title": "%command.aggrega.op.push.title%",
        "category": "%command.category%",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aggrega.op.sign",
        "title": "%command.aggrega.op.sign.title%",
        "category": "%command.category%",
        "icon": "$(verified)"
      },
      {
        "command": "aggrega.op.deprecate",
        "title": "%command.aggrega.op.deprecate.title%",
        "category": "%command.category%",
        "icon": "$(warning)"
      },
      {
        "command": "aggrega.config.open",
        "title": "%command.aggrega.config.open.title%",
        "category": "%command.category%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aggrega.op.cache",
        "title": "%command.aggrega.op.cache.title%",
        "category": "%command.category%",
        "icon": "$(database)"
      },
      {
        "command": "aggrega.server.restart",
        "title": "%command.aggrega.server.restart.title%"
      },
      {
        "command": "aggrega.server.lifecycleActions",
        "title": "%command.aggrega.server.lifecycleActions.title%"
      },
      {
        "command": "aggrega.server.toggleBuildOnInspect",
        "title": "%command.aggrega.server.toggleBuildOnInspect.title%"
      },
      {
        "command": "aggrega.statusBar.openMenu",
        "title": "%command.aggrega.statusBar.openMenu.title%",
        "enablement": "aggrega.compilerAnswerable"
      },
      {
        "command": "aggrega.workspace.switchAnchor",
        "title": "%command.aggrega.workspace.switchAnchor.title%"
      },
      {
        "command": "aggrega.project.selectFolder",
        "title": "%command.aggrega.project.selectFolder.title%"
      },
      {
        "command": "aggrega.release.select",
        "title": "%command.aggrega.release.select.title%"
      },
      {
        "command": "aggrega.workspace.openRootFolder",
        "title": "%command.aggrega.workspace.openRootFolder.title%"
      },
      {
        "command": "aggrega.workspace.openAuthoringReleaseConfig",
        "title": "%command.aggrega.workspace.openAuthoringReleaseConfig.title%"
      },
      {
        "command": "aggrega.workspace.createActiveReleaseMarker",
        "title": "%command.aggrega.workspace.createActiveReleaseMarker.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "aggrega.getStarted.show": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.aggrega.getStarted.show.description%",
          "scope": "machine"
        },
        "aggrega.server.binaryPath": {
          "type": "string",
          "default": "aggrega",
          "markdownDescription": "%configuration.aggrega.server.binaryPath.markdownDescription%",
          "scope": "machine"
        },
        "aggrega.server.buildOnInspect": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.aggrega.server.buildOnInspect.markdownDescription%",
          "scope": "machine"
        },
        "aggrega.server.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "%configuration.aggrega.server.debounceMs.description%",
          "scope": "machine"
        },
        "aggrega.server.respawnAttempts": {
          "type": "number",
          "default": 5,
          "description": "%configuration.aggrega.server.respawnAttempts.description%",
          "scope": "machine"
        },
        "aggrega.server.respawnWindowSeconds": {
          "type": "number",
          "default": 180,
          "description": "%configuration.aggrega.server.respawnWindowSeconds.description%",
          "scope": "machine"
        },
        "aggrega.server.restartGraceSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "markdownDescription": "%configuration.aggrega.server.restartGraceSeconds.markdownDescription%",
          "scope": "machine"
        },
        "aggrega.graph.showSensitiveValues": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.aggrega.graph.showSensitiveValues.description%",
          "scope": "machine"
        },
        "aggrega.operations.layout": {
          "type": "string",
          "enum": [
            "buttons",
            "sections"
          ],
          "enumDescriptions": [
            "%configuration.aggrega.operations.layout.enumDescriptions.0%",
            "%configuration.aggrega.operations.layout.enumDescriptions.1%"
          ],
          "default": "buttons",
          "description": "%configuration.aggrega.operations.layout.description%",
          "scope": "machine"
        },
        "aggrega.notifications.toastDebounceMode": {
          "type": "string",
          "enum": [
            "time",
            "session"
          ],
          "default": "time",
          "markdownDescription": "%configuration.aggrega.notifications.toastDebounceMode.markdownDescription%",
          "scope": "machine"
        },
        "aggrega.notifications.toastThrottleSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "markdownDescription": "%configuration.aggrega.notifications.toastThrottleSeconds.markdownDescription%",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "build-wire-contract": "npm --prefix ../aggrega-abi/typescript install && npm --prefix ../aggrega-abi/typescript run build",
    "compile": "npm run build-wire-contract && tsc -p ./ && npm run copy-vendor-assets && npm run stamp-build-version",
    "copy-vendor-assets": "node build/copy-vendor-assets.js",
    "stamp-build-version": "node build/stamp-build-version.js",
    "l10n-bundle": "node build/l10n-bundle.js",
    "watch": "tsc -watch -p ./",
    "build-fixtures": "node out/test/helpers/build-aggrega.js",
    "pretest": "npm run compile && npm run build-fixtures",
    "test": "mocha out/test/suite/**/*.test.js",
    "test:e2e": "node out/test/e2e/run.js"
  },
  "devDependencies": {
    "@aggrega-ai/aggrega-abi": "file:../aggrega-abi/typescript",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "4.0.0",
    "@vscode/vsce-sign": "file:scripts/vsce-sign-stub",
    "mocha": "^10.0.0",
    "ovsx": "1.4.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "js-yaml": "^4.1.1",
    "semver": "^7.6.0"
  },
  "overrides": {
    "@vscode/vsce-sign": "$@vscode/vsce-sign",
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    },
    "serialize-javascript": "^7.1.3"
  },
  "allowScripts": {
    "keytar": false
  }
}
