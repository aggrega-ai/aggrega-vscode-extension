{
  "name": "aggrega-vscode-extension",
  "displayName": "Aggrega",
  "description": "Language support for Aggrega YAML — validation, navigation, hover, completion via the aggrega daemon.",
  "version": "0.1.0",
  "publisher": "aggrega-ai",
  "license": "Apache-2.0",
  "aggregaCompatibility": ">=0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:yaml",
    "workspaceContains:**/.aggrega-config.yaml"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aggrega",
          "title": "Aggrega",
          "icon": "media/aggrega.svg"
        }
      ]
    },
    "views": {
      "aggrega": [
        {
          "id": "aggrega.operations",
          "name": "Commands",
          "type": "webview"
        },
        {
          "id": "aggrega.registries",
          "name": "Registries"
        },
        {
          "id": "aggrega.workspaceCatalog",
          "name": "Catalog"
        },
        {
          "id": "aggrega.plugins",
          "name": "Plugins"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "aggrega.getStarted.createWorkspace",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.chooseWorkspace",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.useCompilerOnPath",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.locateCompiler",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.draftRelease",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.seedRegistry",
          "when": "false"
        },
        {
          "command": "aggrega.getStarted.seedNamedRegistry",
          "when": "false"
        },
        {
          "command": "aggrega.server.lifecycleActions",
          "when": "false"
        },
        {
          "command": "aggrega.registries.updateOne",
          "when": "false"
        },
        {
          "command": "aggrega.registries.remove",
          "when": "false"
        },
        {
          "command": "aggrega.registries.logout",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.inspect",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.validate",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.lint",
          "when": "false"
        },
        {
          "command": "aggrega.workspaceCatalog.push",
          "when": "false"
        },
        {
          "command": "aggrega.plugins.remove",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "aggrega.settings.open",
          "when": "view == aggrega.operations",
          "group": "navigation"
        },
        {
          "command": "aggrega.plugins.refresh",
          "when": "view == aggrega.plugins",
          "group": "navigation"
        },
        {
          "command": "aggrega.registries.refresh",
          "when": "view == aggrega.registries",
          "group": "navigation"
        },
        {
          "command": "aggrega.workspaceCatalog.refresh",
          "when": "view == aggrega.workspaceCatalog",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aggrega.registries.updateOne",
          "when": "viewItem == aggrega.registry",
          "group": "inline"
        },
        {
          "command": "aggrega.registries.updateOne",
          "when": "viewItem == aggrega.registry",
          "group": "registry@1"
        },
        {
          "command": "aggrega.registries.logout",
          "when": "viewItem == aggrega.registry",
          "group": "registry@2"
        },
        {
          "command": "aggrega.registries.remove",
          "when": "viewItem == aggrega.registry",
          "group": "registry@3"
        },
        {
          "command": "aggrega.workspaceCatalog.inspect",
          "when": "viewItem == aggrega.catalogEntity.document || viewItem == aggrega.catalogEntity.noDocument",
          "group": "inline"
        },
        {
          "command": "aggrega.workspaceCatalog.inspect",
          "when": "viewItem == aggrega.catalogEntity.document || viewItem == aggrega.catalogEntity.noDocument",
          "group": "catalogEntity@1"
        },
        {
          "command": "aggrega.workspaceCatalog.validate",
          "when": "viewItem == aggrega.catalogEntity.document",
          "group": "catalogEntity@2"
        },
        {
          "command": "aggrega.workspaceCatalog.lint",
          "when": "viewItem == aggrega.catalogEntity.document",
          "group": "catalogEntity@3"
        },
        {
          "command": "aggrega.workspaceCatalog.push",
          "when": "viewItem == aggrega.catalogEntity.document",
          "group": "catalogEntityPublish@1"
        },
        {
          "command": "aggrega.plugins.remove",
          "when": "viewItem == aggrega.plugin.configEntry",
          "group": "plugin@1"
        }
      ]
    },
    "commands": [
      {
        "command": "aggrega.getStarted.show",
        "title": "Aggrega: Get started"
      },
      {
        "command": "aggrega.getStarted.dismiss",
        "title": "Aggrega: Stop opening the welcome page on startup"
      },
      {
        "command": "aggrega.getStarted.createWorkspace",
        "title": "Aggrega: Create a workspace configuration"
      },
      {
        "command": "aggrega.getStarted.chooseWorkspace",
        "title": "Aggrega: Use a folder that Aggrega already recognises"
      },
      {
        "command": "aggrega.getStarted.useCompilerOnPath",
        "title": "Aggrega: Use the compiler on my PATH"
      },
      {
        "command": "aggrega.getStarted.locateCompiler",
        "title": "Aggrega: Point at a compiler I have"
      },
      {
        "command": "aggrega.getStarted.draftRelease",
        "title": "Aggrega: Draft a Release"
      },
      {
        "command": "aggrega.getStarted.seedRegistry",
        "title": "Aggrega: Seed the official hub"
      },
      {
        "command": "aggrega.getStarted.seedNamedRegistry",
        "title": "Aggrega: Seed a registry I name"
      },
      {
        "command": "aggrega.settings.open",
        "title": "Open settings",
        "category": "Aggrega",
        "icon": "$(gear)"
      },
      {
        "command": "aggrega.graph.show",
        "title": "Show topology graph",
        "category": "Aggrega",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "aggrega.catalog.searchPublished",
        "title": "Search published catalog",
        "category": "Aggrega",
        "icon": "$(cloud)"
      },
      {
        "command": "aggrega.plugins.refresh",
        "title": "Refresh plugins",
        "category": "Aggrega",
        "icon": "$(refresh)"
      },
      {
        "command": "aggrega.plugins.add",
        "title": "Add plugin",
        "category": "Aggrega",
        "icon": "$(add)"
      },
      {
        "command": "aggrega.plugins.genCatalog",
        "title": "Generate Plugin entities",
        "category": "Aggrega",
        "icon": "$(export)"
      },
      {
        "command": "aggrega.plugins.remove",
        "title": "Remove plugin",
        "category": "Aggrega",
        "icon": "$(trash)"
      },
      {
        "command": "aggrega.registries.refresh",
        "title": "Refresh registries",
        "category": "Aggrega",
        "icon": "$(refresh)"
      },
      {
        "command": "aggrega.registries.add",
        "title": "Add registry",
        "category": "Aggrega",
        "icon": "$(add)"
      },
      {
        "command": "aggrega.registries.update",
        "title": "Update the searchable index",
        "category": "Aggrega",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aggrega.registries.updateOne",
        "title": "Update the searchable index for this registry",
        "category": "Aggrega",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aggrega.registries.remove",
        "title": "Remove registry",
        "category": "Aggrega",
        "icon": "$(trash)"
      },
      {
        "command": "aggrega.registries.logout",
        "title": "Remove stored credential",
        "category": "Aggrega",
        "icon": "$(sign-out)"
      },
      {
        "command": "aggrega.workspaceCatalog.refresh",
        "title": "Refresh workspace catalog",
        "category": "Aggrega",
        "icon": "$(refresh)"
      },
      {
        "command": "aggrega.workspaceCatalog.inspect",
        "title": "Inspect this entity",
        "category": "Aggrega",
        "icon": "$(list-tree)"
      },
      {
        "command": "aggrega.workspaceCatalog.validate",
        "title": "Validate this entity",
        "category": "Aggrega",
        "icon": "$(check)"
      },
      {
        "command": "aggrega.workspaceCatalog.lint",
        "title": "Lint this entity",
        "category": "Aggrega",
        "icon": "$(search)"
      },
      {
        "command": "aggrega.workspaceCatalog.push",
        "title": "Publish this entity",
        "category": "Aggrega",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aggrega.op.validate",
        "title": "Validate active file",
        "category": "Aggrega",
        "icon": "$(check)"
      },
      {
        "command": "aggrega.op.build",
        "title": "Build",
        "category": "Aggrega",
        "icon": "$(package)"
      },
      {
        "command": "aggrega.op.preview",
        "title": "Preview build",
        "category": "Aggrega",
        "icon": "$(eye)"
      },
      {
        "command": "aggrega.op.lint",
        "title": "Lint",
        "category": "Aggrega",
        "icon": "$(search)"
      },
      {
        "command": "aggrega.op.pull",
        "title": "Pull",
        "category": "Aggrega",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aggrega.op.scaffold",
        "title": "Draft entity…",
        "category": "Aggrega",
        "icon": "$(new-file)"
      },
      {
        "command": "aggrega.op.import",
        "title": "Import…",
        "category": "Aggrega",
        "icon": "$(arrow-into)"
      },
      {
        "command": "aggrega.op.inspect",
        "title": "Inspect…",
        "category": "Aggrega",
        "icon": "$(list-tree)"
      },
      {
        "command": "aggrega.op.push",
        "title": "Push…",
        "category": "Aggrega",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aggrega.op.sign",
        "title": "Sign…",
        "category": "Aggrega",
        "icon": "$(verified)"
      },
      {
        "command": "aggrega.op.deprecate",
        "title": "Deprecate…",
        "category": "Aggrega",
        "icon": "$(warning)"
      },
      {
        "command": "aggrega.config.open",
        "title": "Show config",
        "category": "Aggrega",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aggrega.op.cache",
        "title": "Cache…",
        "category": "Aggrega",
        "icon": "$(database)"
      },
      {
        "command": "aggrega.server.restart",
        "title": "Aggrega: Start or restart the language server"
      },
      {
        "command": "aggrega.server.lifecycleActions",
        "title": "Aggrega: Language server actions"
      },
      {
        "command": "aggrega.server.toggleBuildOnInspect",
        "title": "Aggrega: Toggle the build's analysis while inspecting"
      },
      {
        "command": "aggrega.statusBar.openMenu",
        "title": "Aggrega: Open status bar menu",
        "enablement": "aggrega.compilerAnswerable"
      },
      {
        "command": "aggrega.workspace.switchAnchor",
        "title": "Aggrega: Switch anchored folder…"
      },
      {
        "command": "aggrega.release.select",
        "title": "Aggrega: Select Release…"
      },
      {
        "command": "aggrega.workspace.openAuthoringReleaseConfig",
        "title": "Aggrega: Set authoring_release in .aggrega-config.yaml…"
      },
      {
        "command": "aggrega.workspace.createActiveReleaseMarker",
        "title": "Aggrega: Set the selected Release as this workspace's default"
      }
    ],
    "configuration": {
      "title": "Aggrega",
      "properties": {
        "aggrega.getStarted.show": {
          "type": "boolean",
          "default": true,
          "description": "Whether the Aggrega welcome page opens on startup. The page opens in its own tab, says what Aggrega is, then lists what it needs in this workspace — a workspace it recognises, a compiler it can run, a Release to act on, a registry to resolve from — marking each one already met, and marking it to do again if it later lapses. The page carries this same switch at its foot, so it can be turned off from where it is read. Turning it off is also what \"Aggrega: Stop opening the welcome page on startup\" does, and it stops the page opening by itself rather than putting it out of reach. Turning it back on, and opening it, is what \"Aggrega: Get started\" does.",
          "scope": "machine"
        },
        "aggrega.server.binaryPath": {
          "type": "string",
          "default": "aggrega",
          "description": "Path to the aggrega binary. Plain name resolves via PATH; absolute or relative paths are honored as written. This is an editor preference rather than Aggrega's own configuration. That is two files, and most projects need nothing else: `.aggrega-config.yaml` at your project root, whose `workspace:` block marks the directory as that root, and `~/.config/aggrega/config.yaml`, the global file on your machine, for settings that belong to the machine rather than to any one project. Between the two, your project's file wins.",
          "scope": "machine"
        },
        "aggrega.server.autoRevalidate": {
          "type": "boolean",
          "default": false,
          "description": "When true, silently revalidates a file on cache-miss and retries the request. When false, surfaces a notification with a Revalidate action.",
          "scope": "machine"
        },
        "aggrega.server.buildOnInspect": {
          "type": "boolean",
          "default": false,
          "description": "When true, the daemon runs the build's analysis while inspecting an IR graph, so the findings aggrega build reports also appear as editor problems. Inspecting a graph costs more when that analysis runs than when it does not. Nothing is written to disk: no rendered artifacts, no output directory, no lockfile. Off by default, matching aggrega inspect, which raises no such finding either. When true, the extension passes --build-on-inspect to aggrega serve.",
          "scope": "machine"
        },
        "aggrega.server.debounceMs": {
          "type": "number",
          "default": 300,
          "description": "Debounce window in milliseconds for proactive validate-on-change.",
          "scope": "machine"
        },
        "aggrega.server.respawnAttempts": {
          "type": "number",
          "default": 5,
          "description": "Maximum daemon respawn attempts within the sliding window before the extension surfaces a stopped-responding notification.",
          "scope": "machine"
        },
        "aggrega.server.respawnWindowSeconds": {
          "type": "number",
          "default": 180,
          "description": "Sliding window in seconds for counting daemon respawn attempts.",
          "scope": "machine"
        },
        "aggrega.server.restartGraceSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "description": "Grace window in seconds before the extension automatically restarts the daemon after a binaryPath change. The status bar surfaces a countdown during the window; the quick-action menu offers Restart now and Cancel restart.",
          "scope": "machine"
        },
        "aggrega.graph.showSensitiveValues": {
          "type": "boolean",
          "default": false,
          "description": "When true, the topology graph shows every value an attachment authors, including the ones a Feature declares sensitive: a credential an Aggregate authors by value is displayed in the clear, and is readable by anyone who can see the editor window or a screen recording of it. When false, those values are removed before the graph is drawn and the panel names each withheld field and says why it is withheld. Values no sensitivity declaration covers are shown either way.",
          "scope": "machine"
        },
        "aggrega.operations.layout": {
          "type": "string",
          "enum": [
            "buttons",
            "sections"
          ],
          "enumDescriptions": [
            "Every operation is a labelled button in one flow that wraps, with nothing drawn between one group and the next, so everything is visible without opening anything.",
            "Each group is a section you open, under its own title, so the panel shows as much as you keep open."
          ],
          "default": "buttons",
          "description": "How the Commands panel draws its groups. Both shapes carry the same groups with the same operations — the setting changes how a group is drawn, never which operations exist or what they do. Changing it redraws the open panel; nothing restarts.",
          "scope": "machine"
        },
        "aggrega.notifications.toastDebounceMode": {
          "type": "string",
          "enum": [
            "time",
            "session"
          ],
          "default": "time",
          "description": "How repeated toast notifications for the same error code are debounced. `time` re-surfaces after `toastThrottleSeconds` elapses since the last toast went away (action click, X click, or auto-dismiss). `session` suppresses repeats until the daemon restarts.",
          "scope": "machine"
        },
        "aggrega.notifications.toastThrottleSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Throttle window in seconds between toast re-surfacings of the same error code. Consulted only when `toastDebounceMode` is `time`.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-vendor-assets",
    "copy-vendor-assets": "node build/copy-vendor-assets.js",
    "watch": "tsc -watch -p ./",
    "build-fixtures": "node out/test/helpers/build-aggrega.js",
    "pretest": "npm run compile && npm run build-fixtures",
    "test": "mocha out/test/suite/**/*.test.js",
    "test:integration": "npm run compile && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "mocha": "^10.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "elkjs": "^0.12.0",
    "semver": "^7.6.0"
  }
}
